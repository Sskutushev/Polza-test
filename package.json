{
  "name": "polza-tech-task",
  "private": true,
  "packageManager": "pnpm@10.25.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @polza/web dev",
    "build": "pnpm --filter @polza/web build",
    "eslint": "eslint .",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:api": "vitest run tests/api",
    "test:component": "vitest run tests/component",
    "test:e2e": "playwright test",
    "test:perf": "vitest run tests/perf",
    "verify": "npm run eslint && npm run typecheck && npm run test",
    "check:full": "npm run eslint && npm run typecheck && npm run test && npm run migrations:check && npm run format",
    "migrate": "tsx packages/db/src/migrate.ts",
    "migrations": "tsx packages/db/src/migrate.ts",
    "migrations:check": "tsx packages/db/src/migrate.ts",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "load:companies": "tsx packages/ingest/src/cli.ts companies",
    "load:reviews": "tsx packages/ingest/src/cli.ts reviews",
    "profile:csv": "tsx packages/ingest/src/cli.ts profile-csv"
  },
  "dependencies": {
    "@polza/db": "workspace:*",
    "@polza/shared": "workspace:*",
    "csv-parse": "^5.6.0",
    "next": "^15.4.6",
    "pg": "^8.13.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@playwright/test": "^1.54.2",
    "@types/node": "^22.13.14",
    "@types/pg": "^8.11.11",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "eslint": "^9.32.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.39.0",
    "vitest": "^3.2.4"
  }
}
